<Window x:Class="MyBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MyBoard"
    xmlns:vm="clr-namespace:MyBoard.ViewModel"
    xmlns:behaviors="clr-namespace:MyBoard.Behaviors"
    xmlns:controls="clr-namespace:MyBoard.Controls"
    xmlns:converters="clr-namespace:MyBoard.Converters"
    mc:Ignorable="d"
    WindowState="Maximized"
    Title="MyBoard" Height="450" Width="800">


    <Window.Resources>

    </Window.Resources>


    <!--Grid Definitions-->
    <Grid x:Name="RootGrid"
          Focusable="True"
          PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown"
          MouseLeftButtonUp="RootGrid_PreviewMouseLeftButtonUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--breadcrumb-->
            <RowDefinition Height="Auto"/>
            <!--board title-->
            <RowDefinition Height="*"/>
            <!--main content-->
        </Grid.RowDefinitions>

        <!--Row 0: Home and Breadcrumb-->
        <DockPanel Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="48">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,16,0">
                <TextBlock Text="{Binding StorageDisplayText}"
                           Style="{StaticResource CaptionText}"
                           Width="300"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip="{Binding StorageDisplayText}"/>
                <Button Content="Data location…"
                        Margin="10,0,0,0"
                        Padding="10,5"
                        Click="ChangeDataLocation_Click"
                        ToolTip="Choose the folder MyBoard uses on this computer"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding BreadcrumbTrail}"
                          AlternationCount="{Binding BreadcrumbTrail.Count}"
                          Margin="16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Small color swatch echoing this board's own color -->
                            <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,6,0"
                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}"/>

                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsLastItem}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}"
                                                                 Path="(ItemsControl.AlternationIndex)"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                                 Path="Items.Count"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.NavigateToBreadcrumbCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>

                            <TextBlock Text="/" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsLastItem}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}"
                                                                 Path="(ItemsControl.AlternationIndex)"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                                             Path="Items.Count"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Row 1: Undo/Redo (left) + Board Title (center) -->
        <Grid Grid.Row="1" Margin="0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0">
                <Button Content="↶"
                        Command="{Binding UndoCommand}"
                        IsEnabled="{Binding UndoRedo.CanUndo}"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        ToolTip="Undo"/>

                <Button Content="↷" 
                        Command="{Binding RedoCommand}" 
                        IsEnabled="{Binding UndoRedo.CanRedo}"
                        Margin="4,0,0,0"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        ToolTip="Redo"/>
            </StackPanel>

            <TextBlock Text="{Binding CurrentBoard.Title}" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Thin separator between the title bar and the canvas -->
        <Border Grid.Row="1" VerticalAlignment="Bottom"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"/>

        <!--Row 2: Sidebar and Canvas-->
        <Grid Grid.Row="2">

            <!--Canvas Area-->
            <!-- Canvas area: renders whatever is inside CurrentBoard.Items -->
            <!-- Viewport fills the whole column at all times — handles drop/zoom input regardless of how zoomed-out the inner canvas visually is -->
            <Border x:Name="CanvasViewport"
                            Background="#FCFFF9"
                            ClipToBounds="True"
                            AllowDrop="True"
                            DragEnter="BoardCanvas_DragEnter"
                            Drop="BoardCanvas_Drop"
                            MouseWheel="BoardCanvas_MouseWheel"
                            MouseLeftButtonDown="CanvasViewport_MouseLeftButtonDown"
                            PreviewMouseLeftButtonDown="CanvasViewport_PreviewMouseLeftButtonDown"
                            MouseMove="CanvasViewport_MouseMove"
                            MouseLeftButtonUp="CanvasViewport_MouseLeftButtonUp">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Undo" Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="Redo" Command="{Binding DataContext.RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="Paste" Click="MenuItem_PasteCanvas_Click" InputGestureText="Ctrl+V"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <ItemsControl x:Name="BoardCanvas"
                                  ItemsSource="{Binding CurrentBoard.Items}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top">

                        <ItemsControl.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                                <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}"/>
                            </TransformGroup>
                        </ItemsControl.RenderTransform>

                        <!-- Use a Canvas so items can be positioned freely via X/Y -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="{StaticResource BackgroundBrush}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- Positions each item's container using its bound X/Y -->
                        <!-- Positions each item using X/Y, and enables drag via the attached behavior -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                <Setter Property="behaviors:DraggableBehavior.IsDraggable" Value="True"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <!-- Picks the correct visual based on the ViewModel's runtime type -->
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type vm:NoteItemViewModel}">
                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                    <Border x:Name="NoteBorder"
                                            Background="{StaticResource NoteBrush}"
                                            BorderThickness="1.5"
                                            BorderBrush="{StaticResource NoteBorderBrush}"
                                            CornerRadius="6"
                                            Padding="10"
                                            Effect="{StaticResource SoftShadow}">

                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Cut" Click="MenuItem_Cut_Click" InputGestureText="Ctrl+X"/>
                                                <MenuItem Header="Copy" Click="MenuItem_Copy_Click" InputGestureText="Ctrl+C"/>
                                                <MenuItem Header="Duplicate" Click="MenuItem_Duplicate_Click" InputGestureText="Ctrl+D"/>
                                                <Separator/>
                                                <MenuItem Header="Delete" Click="MenuItem_Delete_Click" InputGestureText="Del"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <!-- Display mode: read-only, lets clicks fall through to selection/drag -->
                                            <!-- Placeholder text, shown only when the document is empty and not being edited -->
                                            <TextBlock Text="Type something..."
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowPlaceholder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Edit mode: real TextBox, only shown while IsEditing is true -->
                                            <RichTextBox x:Name="NoteRichTextBox"
                                                         BorderThickness="0" Background="Transparent"
                                                         FontFamily="{StaticResource PrimaryFont}" FontSize="13"
                                                         VerticalScrollBarVisibility="Auto"
                                                         IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                                                         Focusable="{Binding IsEditing}"
                                                         Loaded="NoteRichTextBox_Loaded"
                                                         PreviewKeyDown="NoteRichTextBox_PreviewKeyDown"
                                                         PreviewMouseLeftButtonDown="NoteRichTextBox_PreviewMouseLeftButtonDown"
                                                         PreviewTextInput="NoteRichTextBox_PreviewTextInput"
                                                         PreviewMouseWheel="NoteRichTextBox_PreviewMouseWheel"
                                                         SelectionChanged="NoteRichTextBox_SelectionChanged">
                                                <RichTextBox.Style>
                                                    <Style TargetType="RichTextBox">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <!-- Hidden whenever the placeholder is showing — prevents
                                                                 an empty-but-styled block (quote marks, code background)
                                                                 from rendering underneath the placeholder text -->
                                                            <DataTrigger Binding="{Binding ShowPlaceholder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RichTextBox.Style>
                                            </RichTextBox>
                                        </Grid>
                                    </Border>

                                    <!-- Resize handle -->
                                    <Thumb Style="{StaticResource ResizeThumbStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           DragDelta="ResizeThumb_DragDelta"
                                           DragCompleted="ResizeThumb_DragCompleted"/>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="NoteBorder" 
                                                Property="BorderBrush" 
                                                Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>


                                </DataTemplate.Triggers>
                            </DataTemplate>

                            <!-- Visual for a Board sitting on a parent canvas — looks like a folder tile -->
                            <DataTemplate DataType="{x:Type vm:BoardViewModel}">
                                <Border x:Name="BoardBorder"
                                        BorderThickness="2"
                                        BorderBrush="Transparent"
                                        CornerRadius="10"
                                        Effect="{StaticResource SoftShadow}">

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename" Click="MenuItem_Rename_Click" InputGestureText="F2"/>
                                            <Separator/>
                                            <MenuItem Header="Cut" Click="MenuItem_Cut_Click" InputGestureText="Ctrl+X"/>
                                            <MenuItem Header="Copy" Click="MenuItem_Copy_Click" InputGestureText="Ctrl+C"/>
                                            <MenuItem Header="Duplicate" Click="MenuItem_Duplicate_Click" InputGestureText="Ctrl+D"/>
                                            <Separator/>
                                            <MenuItem Header="Delete" Click="MenuItem_Delete_Click" InputGestureText="Del"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel Width="120" Cursor="Hand">
                                        <Border Background="{Binding Color, Converter={StaticResource HexToBrush}}" CornerRadius="10" Height="70">
                                            <TextBlock Text="📁" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Title area: display TextBlock and edit TextBox occupy the same spot -->
                                        <Grid Margin="0,6,0,0">
                                            <TextBlock x:Name="TitleDisplay"
                                                       Text="{Binding Title}"
                                                       Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MouseLeftButtonDown="BoardTitle_MouseLeftButtonDown"/>

                                            <TextBox x:Name="TitleEditBox"
                                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="SemiBold"
                                                     TextAlignment="Center" BorderThickness="0" Background="Transparent"
                                                     Visibility="Collapsed"
                                                     Loaded="BoardTitleEditBox_Loaded"
                                                     IsVisibleChanged="BoardTitleEditBox_IsVisibleChanged"
                                                     PreviewKeyDown="BoardTitleEditBox_PreviewKeyDown"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Items.Count, StringFormat={}{0} items}"
                                                   Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="BoardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>

                                    <!-- Swaps to edit mode: hide the display title, show the real TextBox -->
                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                        <Setter TargetName="TitleDisplay" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="TitleEditBox" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                            <!-- Visual for an ImageItem — displays the image at its FilePath -->
                            <DataTemplate DataType="{x:Type vm:ImageItemViewModel}">
                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                    <Border x:Name="ImageBorder"
                                            BorderThickness="2"
                                            BorderBrush="Transparent"
                                            CornerRadius="6"
                                            Background="White"
                                            Effect="{StaticResource SoftShadow}">
                                        <Image Source="{Binding FilePath}" Stretch="Uniform"/>

                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Cut" Click="MenuItem_Cut_Click" InputGestureText="Ctrl+X"/>
                                                <MenuItem Header="Copy" Click="MenuItem_Copy_Click" InputGestureText="Ctrl+C"/>
                                                <MenuItem Header="Duplicate" Click="MenuItem_Duplicate_Click" InputGestureText="Ctrl+D"/>
                                                <Separator/>
                                                <MenuItem Header="Delete" Click="MenuItem_Delete_Click" InputGestureText="Del"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                    </Border>


                                    <!-- Resize handle -->
                                    <Thumb Style="{StaticResource ResizeThumbStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           DragDelta="ResizeThumb_DragDelta"
                                           DragCompleted="ResizeThumb_DragCompleted"/>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="ImageBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>

                    <Rectangle x:Name="SelectionBox"
                               Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="1"
                               Fill="#332196F3"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>

                </Grid>

            </Border>


            <!-- Sidebar: collapsed to icon-only width by default, expands on hover, renders above the canvas (Panel.ZIndex) so it never shifts canvas content -->
            <Border x:Name="Sidebar"
                    Background="{StaticResource SidebarBrush}"
                    HorizontalAlignment="Left"
                    Width="60"
                    Panel.ZIndex="10"
                    ClipToBounds="True"
                    Effect="{StaticResource SoftShadow}"
                    MouseEnter="Sidebar_MouseEnter"
                    MouseLeave="Sidebar_MouseLeave">

                <Border.Triggers>

                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Width"
                                    To="180"
                                    Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Width"
                                    To="60"
                                    Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                </Border.Triggers>

                <!-- Sidebar Host -->
                <Grid ClipToBounds="True">

                    <!-- Sliding host -->
                    <Canvas Width="360">

                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="SidebarSlideTransform"/>
                        </Canvas.RenderTransform>

                        <!-- Navigation Panel -->
                        <Border Width="180"
                                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Background="{StaticResource SidebarBrush}"
                                Canvas.Left="0">

                            <StackPanel>

                                <Button Command="{Binding AddNoteCommand}"
                                        Style="{StaticResource SidebarButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝" FontSize="{StaticResource SidebarIconSize}" Width="30"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Note" VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarExpanded, 
                                                                RelativeSource={RelativeSource AncestorType=Window}, 
                                                                Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding AddBoardCommand}"
                                        Style="{StaticResource SidebarButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" FontSize="{StaticResource SidebarIconSize}" Width="30"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Board" VerticalAlignment="Center"
                                                    Visibility="{Binding IsSidebarExpanded, 
                                                                 RelativeSource={RelativeSource AncestorType=Window}, 
                                                                 Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>

                        </Border>

                        <!-- Design Panel -->
                        <Border Width="180"
                                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Canvas.Left="180"
                                Background="{StaticResource SidebarBrush}">

                            <!-- Shows different tools depending on the selected item's TYPE adding a new item type's design tools later means adding one
                                 DataTemplate here, no code-behind or duplicated wiring needed -->
                            <ContentControl Content="{Binding CurrentBoard.PrimarySelectedItem}">
                                <ContentControl.Resources>

                                    <DataTemplate DataType="{x:Type vm:BoardViewModel}">
                                        <StackPanel>
                                            <controls:ColorPickerButton x:Name="BoardColorTool"
                                                                        SelectedColor="{Binding Color, Mode=TwoWay}"
                                                                        IsExpanded="{Binding IsSidebarExpanded, 
                                                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Palette="{Binding DataContext.ColorPalette, 
                                                                                          ElementName=RootGrid}"
                                                                        ColorSelected="DesignColorPicker_ColorSelected"
                                                                        PopoverOpened="DesignColorPicker_PopoverOpened"
                                                                        PopoverClosed="DesignColorPicker_PopoverClosed"/>
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- Future: a DataTemplate for vm:NoteItemViewModel or
                                         vm:ImageItemViewModel would go here, reusing the same
                                         ColorPickerButton control if/when those get color options -->
                                    <DataTemplate DataType="{x:Type vm:NoteItemViewModel}">
                                        <StackPanel>
                                            <controls:TextStylePicker x:Name="NoteTextStyleTool"
                                                                       IsExpanded="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       AboutToOpen="NoteDesignTool_AboutToOpen" 
                                                                       PopoverOpened="NoteDesignTool_PopoverOpened"
                                                                       PopoverClosed="NoteDesignTool_PopoverClosed"/>

                                            <Separator/>

                                            <!-- Formatting row 1: character styles -->
                                            <StackPanel>
                                                <ToggleButton x:Name="BoldToggle" HorizontalAlignment="Stretch" Style="{StaticResource FormatToggleButtonStyle}" Click="FormatToggle_Click" Loaded="FormatToggle_Loaded" Tag="Bold">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="B" FontWeight="Bold" FontSize="{StaticResource SidebarIconSize}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Bold" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </ToggleButton>

                                                <ToggleButton x:Name="ItalicToggle" HorizontalAlignment="Stretch" Style="{StaticResource FormatToggleButtonStyle}" Click="FormatToggle_Click" Loaded="FormatToggle_Loaded" Tag="Italic">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="I" FontStyle="Italic" FontSize="{StaticResource SidebarIconSize}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Italic" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </ToggleButton>

                                                <ToggleButton x:Name="UnderlineToggle" HorizontalAlignment="Stretch" Style="{StaticResource FormatToggleButtonStyle}" Click="FormatToggle_Click" Loaded="FormatToggle_Loaded" Tag="Underline">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="U" TextDecorations="Underline" FontSize="{StaticResource SidebarIconSize}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Underline" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </ToggleButton>

                                                <ToggleButton x:Name="StrikeToggle" HorizontalAlignment="Stretch" Style="{StaticResource FormatToggleButtonStyle}" Click="FormatToggle_Click" Loaded="FormatToggle_Loaded" Tag="Strikethrough">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="{StaticResource SidebarIconSize}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Strikethrough" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </ToggleButton>

                                                <Separator/>

                                                <ToggleButton x:Name="BulletToggle" HorizontalAlignment="Stretch" Style="{StaticResource FormatToggleButtonStyle}" Click="FormatToggle_Click" Loaded="FormatToggle_Loaded" Tag="Bullet">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="•" FontSize="{StaticResource SidebarIconSize}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Bullet" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </ToggleButton>

                                                <ToggleButton x:Name="NumberedToggle" HorizontalAlignment="Stretch" Style="{StaticResource FormatToggleButtonStyle}" Click="FormatToggle_Click" Loaded="FormatToggle_Loaded" Tag="Numbered">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="1." FontSize="{StaticResource SidebarIconSize}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Numbered" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </ToggleButton>

                                                <ToggleButton x:Name="CheckboxToggle" HorizontalAlignment="Stretch" Style="{StaticResource FormatToggleButtonStyle}" Click="FormatToggle_Click" Loaded="FormatToggle_Loaded" Tag="Checkbox">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="☐" FontSize="{StaticResource SidebarIconSize}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Checkbox" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type vm:ImageItemViewModel}">
                                        <Grid/>
                                    </DataTemplate>

                                </ContentControl.Resources>
                            </ContentControl>
                        </Border>

                    </Canvas>

                    <!-- Separator -->
                    <Rectangle Width="1"
                               Fill="{StaticResource BorderBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Stretch"
                               IsHitTestVisible="False"/>

                </Grid>

            </Border>


            <!-- Zoom percentage indicator — floats in the bottom-center of the canvas -->
            <Border Background="{StaticResource SidebarBrush}"
                    CornerRadius="6"
                    Padding="10,5"
                    Margin="0,0,16,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Effect="{StaticResource SoftShadow}"
                    Panel.ZIndex="5">
                <TextBlock Text="{Binding ZoomDisplayText}" Style="{StaticResource CaptionText}"/>
            </Border>

        </Grid>
    </Grid>
</Window>
