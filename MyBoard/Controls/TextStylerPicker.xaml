<UserControl x:Class="MyBoard.Controls.TextStylePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <StackPanel>
        <Button x:Name="ToggleButton" Style="{StaticResource SidebarButtonStyle}" Click="ToggleButton_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="T" FontWeight="Bold" FontSize="{StaticResource SidebarIconSize}" Width="30"
                           TextAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Text style" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsExpanded, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Button>

        <Popup x:Name="StylePopup" Placement="Absolute" AllowsTransparency="True"
               StaysOpen="True" PopupAnimation="Fade" Opened="StylePopup_Opened">
            <Border Background="{StaticResource SidebarBrush}" CornerRadius="8" Padding="8"
                    Effect="{StaticResource SoftShadow}" Width="180">
                <StackPanel>
                    <RadioButton Content="Large heading" FontSize="20" FontWeight="Bold"
                                 Tag="LargeHeading" Click="StyleOption_Click" Style="{StaticResource TextStyleOptionStyle}"/>
                    <RadioButton Content="Normal heading" FontSize="16" FontWeight="Bold"
                                 Tag="NormalHeading" Click="StyleOption_Click" Style="{StaticResource TextStyleOptionStyle}"/>
                    <RadioButton Content="Normal text" FontSize="13"
                                 Tag="Normal" Click="StyleOption_Click" Style="{StaticResource TextStyleOptionStyle}"/>
                    <RadioButton Content="Small text" FontSize="11"
                                 Tag="SmallText" Click="StyleOption_Click" Style="{StaticResource TextStyleOptionStyle}"/>
                    <RadioButton Content="Code block" FontFamily="Consolas" FontSize="12"
                                 Tag="CodeBlock" Click="StyleOption_Click" Style="{StaticResource TextStyleOptionStyle}"/>
                    <RadioButton Content="Quote block" FontStyle="Italic" FontSize="13"
                                 Tag="QuoteBlock" Click="StyleOption_Click" Style="{StaticResource TextStyleOptionStyle}"/>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>