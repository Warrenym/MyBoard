<UserControl x:Class="MyBoard.Controls.ColorPaletteRows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RowsRoot">

    <StackPanel Width="200">

        <!-- Header: title + Edit toggle -->
        <Grid Margin="0,0,0,6">
            <TextBlock Text="Palette" Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
            <ToggleButton x:Name="EditToggle" Content="Edit"
                          HorizontalAlignment="Right"
                          IsChecked="{Binding IsEditMode, ElementName=RowsRoot, Mode=TwoWay}"
                          Padding="6,2" FontSize="11"/>
        </Grid>

        <TextBlock Text="Default" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
        <!-- Tag identifies which PaletteRow this is for the Drop handler; AllowDrop+Drop enable drag targeting -->
        <ItemsControl x:Name="DefaultItemsControl" Tag="Default" AllowDrop="True" Drop="Row_Drop"
                      ItemsSource="{Binding DefaultColors}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Default row has no delete overlay — it's permanent, per your earlier decision -->
                    <Border Width="22" Height="22" CornerRadius="4" Margin="3"
                            Background="{Binding Converter={StaticResource HexToBrush}}"
                            BorderBrush="#DDDDDD" BorderThickness="1" Cursor="Hand"
                            Tag="Default"
                            MouseLeftButtonDown="Swatch_MouseLeftButtonDown"
                            MouseMove="Swatch_MouseMove"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Saved row header with a "+" button to save the currently active color -->
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Saved" Style="{StaticResource CaptionText}"/>
            <Button Content="+" Padding="6,0" FontSize="12"
                    HorizontalAlignment="Right" Click="AddSavedButton_Click"/>
        </Grid>
        <ItemsControl x:Name="SavedItemsControl" Tag="Saved" AllowDrop="True" Drop="Row_Drop"
                      ItemsSource="{Binding SavedColors}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="SwatchContainer" Width="22" Height="22" Margin="3">
                        <Border CornerRadius="4"
                                Background="{Binding Converter={StaticResource HexToBrush}}"
                                BorderBrush="#DDDDDD" BorderThickness="1" Cursor="Hand"
                                Tag="Saved"
                                MouseLeftButtonDown="Swatch_MouseLeftButtonDown"
                                MouseMove="Swatch_MouseMove"/>

                        <!-- Delete overlay: only visible while hovering AND in edit mode -->
                        <Border x:Name="DeleteOverlay" Width="12" Height="12" CornerRadius="6"
                                Background="#DD333333"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-4,0"
                                Visibility="Collapsed" Cursor="Hand"
                                MouseLeftButtonDown="DeleteButton_MouseLeftButtonDown" Tag="Saved">
                            <TextBlock Text="−" Foreground="White" FontWeight="Bold" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        
                    </Grid>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=SwatchContainer}" Value="True"/>
                                <Condition Binding="{Binding IsEditMode, ElementName=RowsRoot}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="DeleteOverlay" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Recently Picked" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
        <ItemsControl x:Name="RecentItemsControl" Tag="Recent" AllowDrop="True" Drop="Row_Drop"
                      ItemsSource="{Binding RecentlyPicked}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="SwatchContainer" Width="22" Height="22" Margin="3">
                        <Border CornerRadius="4"
                                Background="{Binding Converter={StaticResource HexToBrush}}"
                                BorderBrush="#DDDDDD" BorderThickness="1" Cursor="Hand"
                                Tag="Recent"
                                MouseLeftButtonDown="Swatch_MouseLeftButtonDown"
                                MouseMove="Swatch_MouseMove">
                            <!-- Right-click quick-save, always available regardless of edit mode -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Save to Saved"
                                              Click="SaveFromRecent_Click"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>

                        <Border x:Name="DeleteOverlay" Width="12" Height="12" CornerRadius="6"
                                Background="#DD333333"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-4,0"
                                Visibility="Collapsed" Cursor="Hand"
                                MouseLeftButtonDown="DeleteButton_MouseLeftButtonDown" Tag="Saved">     
                            <TextBlock Text="−" Foreground="White" FontWeight="Bold" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=SwatchContainer}" Value="True"/>
                                <Condition Binding="{Binding IsEditMode, ElementName=RowsRoot}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="DeleteOverlay" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
