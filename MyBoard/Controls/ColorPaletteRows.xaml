<UserControl x:Class="MyBoard.Controls.ColorPaletteRows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Width="200">

        <TextBlock Text="Default" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
        <ItemsControl ItemsSource="{Binding DefaultColors}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="22" Height="22" CornerRadius="4" Margin="3"
                            Background="{Binding Converter={StaticResource HexToBrush}}"
                            BorderBrush="#DDDDDD" BorderThickness="1" Cursor="Hand"
                            Tag="Default" MouseLeftButtonDown="Swatch_MouseLeftButtonDown"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Saved" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
        <ItemsControl ItemsSource="{Binding SavedColors}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="22" Height="22" CornerRadius="4" Margin="3"
                            Background="{Binding Converter={StaticResource HexToBrush}}"
                            BorderBrush="#DDDDDD" BorderThickness="1" Cursor="Hand"
                            Tag="Saved" MouseLeftButtonDown="Swatch_MouseLeftButtonDown"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Recently Picked" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
        <ItemsControl ItemsSource="{Binding RecentlyPicked}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="22" Height="22" CornerRadius="4" Margin="3"
                            Background="{Binding Converter={StaticResource HexToBrush}}"
                            BorderBrush="#DDDDDD" BorderThickness="1" Cursor="Hand"
                            Tag="Recent" MouseLeftButtonDown="Swatch_MouseLeftButtonDown"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>