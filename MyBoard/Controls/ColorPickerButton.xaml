<UserControl x:Class="MyBoard.Controls.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MyBoard.Controls"
             x:Name="Root">

    <StackPanel>
        <Button x:Name="ToggleButton" Style="{StaticResource SidebarButtonStyle}" Click="ToggleButton_Click">
            <StackPanel Orientation="Horizontal">
                <Border Width="18" Height="18" CornerRadius="4"
                        Background="{Binding SelectedColor, ElementName=Root, Converter={StaticResource HexToBrush}}"
                        BorderBrush="#CCCCCC" BorderThickness="1"
                        Margin="6,0,0,0"/>
                <TextBlock Text="Color" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="{Binding IsExpanded, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Button>

        <!-- Placement="Absolute" + manual positioning in code-behind is what makes this
             work correctly regardless of any RenderTransform on ancestors (like the
             sidebar's slide animation) — WPF's automatic placement modes ignore those. -->
        <Popup x:Name="ColorPopup"
               Placement="Absolute"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Opened="ColorPopup_Opened"
               Closed="ColorPopup_Closed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Diamond notch: a square rotated 45°, pulled halfway into the panel
                     via negative margin so only the pointed left half is visible,
                     seamlessly merging with the panel's edge (same background = no seam) -->
                <Border Grid.Column="0" Width="14" Height="14"
                        Background="{StaticResource SidebarBrush}"
                        VerticalAlignment="Top" Margin="0,18,-7,0"> 
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource SidebarBrush}"
                        CornerRadius="8" Padding="14" Effect="{StaticResource SoftShadow}">
                    <controls:ColorPickerControl x:Name="InnerColorPicker" ColorSelected="InnerColorPicker_ColorSelected"/>
                </Border>
            </Grid>
        </Popup>
    </StackPanel>
</UserControl>