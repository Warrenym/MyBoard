<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">




    <!-- ================= COLOR PALETTE ================= -->
    <!-- Soft, muted tones instead of saturated colors — keeps the app feeling calm -->

    <Color x:Key="BackgroundColor">#FAFAF8</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="NoteColor">#FEFAE0</Color>
    <Color x:Key="NoteBorderColor">#F2E4A8</Color>
    <Color x:Key="BoardAccentColor">#C9B8F0</Color>
    <Color x:Key="AccentColor">#8A8A8A</Color>
    <Color x:Key="TextPrimaryColor">#2A2A2A</Color>
    <Color x:Key="TextSecondaryColor">#8A8A8A</Color>
    <Color x:Key="BorderColor">#ECECEC</Color>

    <!-- ================= SIDEBAR ICON SIZE ================= -->
    <!-- One shared size for every glyph/emoji icon in the sidebar (Note,
         Board, Text Style "T", format B/I/U/S) so they all scale together
         consistently instead of each drifting to its own ad-hoc size -->
    <sys:Double x:Key="SidebarIconSize">18</sys:Double>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="NoteBrush" Color="{StaticResource NoteColor}"/>
    <SolidColorBrush x:Key="NoteBorderBrush" Color="{StaticResource NoteBorderColor}"/>
    <SolidColorBrush x:Key="BoardAccentBrush" Color="{StaticResource BoardAccentColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>



    <!-- ================= TYPOGRAPHY ================= -->

    <FontFamily x:Key="PrimaryFont">/MyBoard;component/Assets/Fonts/#Nunito</FontFamily>
    <FontFamily x:Key="HeaderFont">/MyBoard;component/Assets/Fonts/#Quicksand</FontFamily>

    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>



    <!-- ================= SOFT SHADOW ================= -->
    <!-- Reused on cards/tiles to give a gentle sense of depth without being heavy -->

    <DropShadowEffect x:Key="SoftShadow"
                       Color="#000000" Opacity="0.12"
                       BlurRadius="10" ShadowDepth="2" Direction="270"/>



    <!-- ================= SIDEBAR BUTTON STYLE ================= -->

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Rounded hover background, no default WPF button chrome -->
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Margin="6,3">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F0EEFB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact icon buttons used by the board toolbar. Keeping these separate
         from SidebarButtonStyle prevents the sidebar's generous padding and
         left alignment from making Undo/Redo look tiny and off-centre. -->
    <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F0EEFB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ================= TOGGLE BUTTON STYLE ================= -->

    <Style x:Key="FormatToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- Matches SidebarButtonStyle exactly: no fixed size, content
                         left-aligned so the icon sits flush left just like
                         Text Style/Note/Board, with the label only taking up
                         room when the sidebar is actually expanded -->
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Margin="6,3">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#F0EEFB"/>
                        </Trigger>
                        <!-- Active state: reflects whatever the caret's current formatting is,
                         not whether the button was "clicked last" -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#DCD4F5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================= CONTEXT MENU ================= -->
    <!-- Softened right-click menu: rounded corners, generous padding, warm
     hover color instead of the default Windows blue, matches the app's
     rounded/soft visual language everywhere else -->

    <Style x:Key="FriendlyContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}"
                        Effect="{StaticResource SoftShadow}">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FriendlyMenuItemStyle" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder" CornerRadius="6" Margin="2,1" Background="Transparent">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Warm lavender hover instead of the default harsh blue highlight -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#F0EEFB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter TargetName="ItemBorder" Property="Background" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Softened separator line between menu sections -->
    <Style x:Key="FriendlySeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>


    <Style TargetType="ContextMenu" BasedOn="{StaticResource FriendlyContextMenuStyle}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource FriendlyMenuItemStyle}"/>
    <Style TargetType="Separator" BasedOn="{StaticResource FriendlySeparatorStyle}"/>



    <!-- ================= RESIZE THUMB ================= -->
    <!-- Minimal diagonal slash instead of the default gray square handle —
     transparent hit area stays the same size for easy grabbing, but only
     the thin line is visually shown -->

    <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="SizeNWSE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Transparent Grid keeps the full hit area draggable,
                     even though only the Line is visible -->
                    <Grid Background="Transparent">
                        <Line x:Name="Slash"
                          X1="4" Y1="12" X2="12" Y2="4"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Darkens slightly on hover, giving feedback without adding visual weight -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Slash" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================= TEXT STYLER ================= -->
    <Style x:Key="TextStyleOptionStyle" TargetType="RadioButton">
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="OptionBorder" CornerRadius="6" Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OptionBorder" Property="Background" Value="#F0EEFB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= SCROLLBAR ================= -->
    <!-- Minimal, rounded scrollbar matching the app's soft visual language,
         replacing the default stock Windows scrollbar. Applied as an
         IMPLICIT style (no x:Key) so every scrollable control in the app —
         including the Note's RichTextBox, and anything scrollable added
         later — picks this up automatically with no extra wiring needed. -->

    <Style x:Key="ThemedScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{StaticResource BorderBrush}"
                            CornerRadius="4"
                            Margin="2"/>
                    <ControlTemplate.Triggers>
                        <!-- Darkens toward the accent color on hover, giving
                             feedback without adding visual weight when idle -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <!-- Vertical layout: track fills the full height, no
                             visible line-up/line-down arrow buttons — clicking
                             the track above/below the thumb still pages -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Background="Transparent" BorderThickness="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Background="Transparent" BorderThickness="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThemedScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Horizontal scrollbars use the same visual language,
                             just rotated — width/height swap accordingly -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
